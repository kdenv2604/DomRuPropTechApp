# Текстовые файлы храним одинаково на Linux и Windows.
* text=auto

*.bat text eol=crlf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.properties text eol=lf

# Gradle Wrapper содержит готовый двоичный файл.
*.jar binary

*.swift text eol=lf
*.py text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.xcprivacy text eol=lf
gradlew text eol=lf
*.mp4 binary
*.flv binary
